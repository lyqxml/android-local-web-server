<?xml version="1.0" encoding="utf-8"?>
<!-- 高斯模糊底栏：轻微提亮 + 1px 高光描边 + 与悬浮条一致的 28dp 圆角，
     让玻璃在纯色背景上也看得出是「浮起来的一层」 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nav_scrim" />
    <stroke android:width="1dp" android:color="@color/nav_rim" />
    <corners android:radius="28dp" />
</shape>
